# Private deployment keys belong only in the ignored .env file.
STUDIONET_PRIVATE_KEY=
STUDIONET_INTEGRATOR_PRIVATE_KEY=

# Public frontend configuration. Leave the address empty until a verified
# Studionet deployment exists; the UI must remain honest and unconfigured.
VITE_REPLIGRANT_CONTRACT_ADDRESS=
VITE_GENLAYER_RPC_URL=/genlayer-rpc
